APP_NAME=Forge & Form Personal Training
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forgeform
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP_ID=forgeform-workers
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
BUSINESS_EMAIL=training@forgeandform.com
BUSINESS_PHONE=(503) 555-0139
BUSINESS_ADDRESS=1900 Division Street, Portland, OR 97202
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_CAPACITY_PER_SLOT=0
MAX_REQUEST_BYTES=65536
